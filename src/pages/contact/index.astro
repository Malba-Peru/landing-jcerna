---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/contact/ContactForm.jsx";
import Icon from "astro-icon";
---

<BaseLayout>

<section id="contact-page">
   <video
    class="background-video"
    autoplay
    muted
    loop
    playsinline
  >
    <source src="/videos/contact_bg.mp4" type="video/mp4" />
  </video>

  <div class="video-overlay"></div>


  <h1 class="section-title">
    CONTACTO
  </h1>

  <p class="section-description">
    Estamos comprometidos en brindar soluciones eficientes y atención personalizada para cada proyecto.
  </p>

  <div class="contact-grid">

    <div class="contact-info">

      <div class="features">

        <div class="feature-card">
          <div class="icon">
            <Icon
              pack="mdi"
              name="hammer-wrench"
              size={28}
            />
          </div>

          <div class="content">
            <h3>RIGOR TÉCNICO</h3>

            <p>
              Garantizamos control, precisión y máximo detalle desde la selección de materiales hasta acabados.
            </p>
          </div>
        </div>

        <div class="feature-card">
          <div class="icon">
            <Icon
              pack="mdi"
              name="shield-check"
              size={28}
            />
          </div>

          <div class="content">
            <h3>SOLUCIONES INTEGRALES</h3>

            <p>
              Creamos soluciones multidisciplinares de diseño y construcción con propuestas innovadoras.
            </p>
          </div>
        </div>

        <div class="feature-card">
          <div class="icon">
            <Icon
              pack="mdi"
              name="cash-check"
              size={28}
            />
          </div>

          <div class="content">
            <h3>TRANSPARENCIA FINANCIERA</h3>

            <p>
              Ofrecemos presupuestos transparentes y excelente calidad estructural para proteger su capital.
            </p>
          </div>
        </div>

      </div>

    </div>

    <div class="contact-form-wrapper">
      <ContactForm client:load />
    </div>

  </div>

</section>

</BaseLayout>

<style lang="scss">
#contact-page {
  position: relative;
  overflow: hidden;

  padding: 0.5rem 7% 4rem;

  .background-video {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    z-index: 0;
  }

  .video-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        135deg,
        rgba(0, 0, 0, 0.75),
        rgba(0, 0, 0, 0.45)
      );

    z-index: 1;
  }

  .section-title,
  .section-description,
  .contact-grid {
    position: relative;
    z-index: 2;
  }

  .section-title {
    text-align: center;
    font-size: 2.5em;
    font-weight: 800;
    text-transform: uppercase;
    color: white;
  }

  .section-description {
    max-width: 800px;
    margin: 0 auto 4rem;
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.2rem;
    line-height: 1.8;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;

    .features {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;
      height: 100%;

      .feature-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-height: 140px;
        padding: 2rem;

        background: rgba(255, 255, 255, 0.92);

        backdrop-filter: blur(12px);

        border-radius: 18px;

        border: 1px solid rgba(255, 255, 255, 0.4);

        box-shadow:
          0 10px 25px rgba(0, 0, 0, 0.12);

        transition: all .3s ease;

        &:hover {
          transform: translateY(-8px);

          box-shadow:
            0 20px 40px rgba(1, 116, 183, 0.25);
        }

        .icon {
          min-width: 70px;
          width: 70px;
          height: 70px;

          border-radius: 50%;

          display: flex;
          align-items: center;
          justify-content: center;

          color: white;

          background: linear-gradient(
            135deg,
            #0174b7,
            #38bdf8
          );
        }

        .content {
          h3 {
            color: #0f172a;
            margin-bottom: .3rem;
            font-size: 1.15rem;
          }

          p {
            color: #475569;
            line-height: 1.6;
          }
        }
      }
    }
  }

  .contact-form-wrapper {
    position: sticky;
    top: 120px;

    background: rgba(255, 255, 255, 0.95);

    backdrop-filter: blur(12px);

    padding: 2rem;

    border-radius: 24px;

    border: 1px solid rgba(255, 255, 255, 0.4);

    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-form-wrapper {
      order: 1;
      position: static;
      top: auto;
    }

    .contact-info {
      order: 2;
    }
  }

  @media (max-width: 768px) {
    padding: 4rem 5%;

    .section-title {
      font-size: 2em;
    }

    .section-description {
      margin-bottom: 3rem;
    }
  }

  @media (max-width: 480px) {
    padding: 3rem 1rem;

    .section-title {
      font-size: 1.8em;
    }

    .section-description {
      font-size: .95rem;
    }

    .contact-info {
      .features {
        .feature-card {
          flex-direction: column;
          text-align: center;

          .icon {
            margin: 0 auto;
          }
        }
      }
    }

    .contact-form-wrapper {
      padding: 1.2rem;
    }
  }
}
</style>