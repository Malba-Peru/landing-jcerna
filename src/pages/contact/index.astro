---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/contact/ContactForm.jsx";
import Icon from "astro-icon";
---

<BaseLayout>

<section id="contact-page">

  <h1 class="section-title">
    CONTACTO
  </h1>

  <p class="section-description">
    Estamos comprometidos en brindar soluciones eficientes y atención personalizada para cada proyecto.
  </p>

  <div class="contact-grid">

    <div class="contact-info">

      <div class="features">

        <div class="feature-card">
          <div class="icon">
            <Icon
              pack="mdi"
              name="lightning-bolt"
              size={28}
            />
          </div>

          <div class="content">
            <h3>Respuesta Rápida</h3>

            <p>
              Atendemos cada consulta en el menor tiempo posible para brindar
              una atención eficiente.
            </p>
          </div>
        </div>

        <div class="feature-card">
          <div class="icon">
            <Icon
              pack="mdi"
              name="shield-check"
              size={28}
            />
          </div>

          <div class="content">
            <h3>Confianza y Calidad</h3>

            <p>
              Comprometidos con soluciones seguras, responsables y profesionales.
            </p>
          </div>
        </div>

        <div class="feature-card">
          <div class="icon">
            <Icon
              pack="mdi"
              name="account-group"
              size={28}
            />
          </div>

          <div class="content">
            <h3>Equipo Especializado</h3>

            <p>
              Personal capacitado para cada proyecto y necesidad específica.
            </p>
          </div>
        </div>

      </div>

      <div class="map-card">

        <h2 class="map-title">
          NUESTRA UBICACIÓN
        </h2>

        <iframe
          src="https://www.google.com/maps/embed?pb=!1m13!1m8!1m3!1d344.7040518839279!2d-77.01860693868153!3d-12.188488585905684!3m2!1i1024!2i768!4f13.1!3m2!1m1!2s!5e0!3m2!1ses!2spe!4v1780461477706!5m2!1ses!2spe"
          loading="lazy"
          allowfullscreen=""
        >
        </iframe>

      </div>

    </div>

    <div class="contact-form-wrapper">
      <ContactForm client:load />
    </div>

  </div>

</section>

</BaseLayout>

<style lang="scss">
#contact-page {
  padding: 1.5rem 7%;
  background: #f8fafc;

  .section-title {
    text-align: center;

    font-size: 2em;

    font-weight: 800;

    color: #0174b7;


    &::after {
      content: "";

      display: block;

      width: 90px;
      height: 4px;

      margin: 1rem auto 0;

      border-radius: 999px;

      background: #0174b7;
    }
  }

  .section-description {
    max-width: 800px;

    margin: 0 auto 4rem;

    text-align: center;

    color: #64748b;

    font-size: 1.05rem;

    line-height: 1.8;
  }

  .contact-grid {
    display: grid;

    grid-template-columns: 1.1fr 0.9fr;

    gap: 3rem;

    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;

    gap: 2rem;

    .features {
      display: flex;
      flex-direction: column;

      gap: 1.2rem;

      .feature-card {
        display: flex;
        align-items: center;

        gap: 1rem;

        padding: 1.5rem;

        background: #fff;

        border-radius: 18px;

        box-shadow:
          0 10px 25px rgba(0, 0, 0, 0.05);

        transition: all .3s ease;

        &:hover {
          transform: translateY(-5px);

          box-shadow:
            0 15px 35px rgba(1, 116, 183, 0.15);
        }

        .icon {
          min-width: 60px;

          width: 60px;
          height: 60px;

          border-radius: 50%;

          display: flex;
          align-items: center;
          justify-content: center;

          color: white;

          background: linear-gradient(
            135deg,
            #0174b7,
            #38bdf8
          );
        }

        .content {
          h3 {
            color: #0f172a;

            margin-bottom: .3rem;

            font-size: 1.15rem;
          }

          p {
            color: #64748b;

            line-height: 1.6;
          }
        }
      }
    }

    .map-card {
      background: white;

      border-radius: 20px;

      overflow: hidden;

      box-shadow:
        0 10px 25px rgba(0, 0, 0, 0.05);

      .map-title {
        text-align: center;

        color: #0174b7;

        font-size: 1.4rem;

        font-weight: 700;

        padding: 1.4rem;

        border-bottom: 1px solid #e5e7eb;
      }

      iframe {
        width: 100%;
        height: 380px;

        border: 0;
      }
    }
  }

  .contact-form-wrapper {
    position: sticky;
    top: 120px;

    background: white;

    padding: 2rem;

    border-radius: 24px;

    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.08);
  }

@media (max-width: 992px) {
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .contact-form-wrapper {
    order: 1;

    position: static;
    top: auto;
  }

  .contact-info {
    order: 2;
  }
}

  @media (max-width: 768px) {
    padding: 4rem 5%;

    .section-title {
      font-size: 2.5rem;
    }

    .section-description {
      margin-bottom: 3rem;
    }

    .contact-info {
      .map-card {
        iframe {
          height: 300px;
        }
      }
    }
  }

  @media (max-width: 480px) {
    padding: 3rem 1rem;

    .section-title {
      font-size: 2rem;
    }

    .section-description {
      font-size: .95rem;
    }

    .contact-info {
      .features {
        .feature-card {
          flex-direction: column;

          text-align: center;

          .icon {
            margin: 0 auto;
          }
        }
      }

      .map-card {
        .map-title {
          font-size: 1.2rem;
        }

        iframe {
          height: 250px;
        }
      }
    }

    .contact-form-wrapper {
      padding: 1.2rem;
    }
  }
}
</style>