---
import { workflow } from "../../data-list";
import Icon from "astro-icon";
---

<section class="process">
  <h1>PROCESO DE TRABAJO</h1>

  <div class="grid">
    {workflow.map((step) => (
      <div class="card">
        <div class="overlay"></div>

        <div class="content">
          <div class="icon-wrapper">
            <Icon name={step.icon} class="icon" />
          </div>

          <h2>{step.title}</h2>
          <p>{step.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style lang="scss">
.process {
  padding: 3rem 1rem;

  max-width: 1200px;

  margin: auto;

  h1 {
    text-align: center;

    margin-bottom: 2rem;

    font-size: 2.5em;

    color: #0174B7;

    text-transform: uppercase;

    font-weight: 800;
  }

  .grid {
    display: grid;

    gap: 1.5rem;

    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));

    .card {
      position: relative;

      overflow: hidden;

      border-radius: 14px;

      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;

      box-shadow:
        0 10px 25px rgba(0, 0, 0, 0.18);

      transition: all 0.3s ease;

      &:nth-child(1) {
        background-image: url("/images/trabajo_fondo_1.webp");
      }

      &:nth-child(2) {
        background-image: url("/images/trabajo_fondo_2.webp");
      }

      &:nth-child(3) {
        background-image: url("/images/trabajo_fondo_3.webp");
      }

      &:nth-child(4) {
        background-image: url("/images/trabajo_fondo_4.webp");
      }

      &:hover {
        transform: translateY(-6px);

        box-shadow:
          0 20px 35px rgba(0, 0, 0, 0.25);
      }

      .overlay {
        position: absolute;

        inset: 0;

        background:
          linear-gradient(
            135deg,
            rgba(0, 0, 0, 0.30) 0%,
            rgba(0, 0, 0, 0.55) 55%,
            rgba(0, 0, 0, 0.72) 100%
          );
      }

      .content {
        position: relative;

        z-index: 2;

        padding: 2rem 1.5rem;

        text-align: center;

        color: white;
      }

      .icon-wrapper {
        width: 65px;
        height: 65px;

        margin: 0 auto 1rem;

        background: rgba(0, 0, 0, 0.35);

        backdrop-filter: blur(6px);

        border: 2px solid rgba(255, 255, 255, 0.25);

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        box-shadow:
          0 0 20px rgba(255, 255, 255, 0.12);

        .icon {
          width: 32px;
          height: 32px;

          color: white;
        }
      }

      h2 {
        font-size: 1.3rem;

        margin: 0.5rem 0 0.7rem;

        font-weight: 600;

        color: white;
      }

      p {
        font-size: 1rem;

        line-height: 1.5;

        text-align: justify;

        color: rgba(255, 255, 255, 0.95);
      }
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    padding: 2rem 1rem;

    h1 {
      font-size: 1.8rem;
    }

    .grid {
      .card {
        .content {
          padding: 1.5rem;
        }

        .icon-wrapper {
          width: 58px;
          height: 58px;

          .icon {
            width: 28px;
            height: 28px;
          }
        }

        h2 {
          font-size: 1.15rem;
        }

        p {
          font-size: 0.95rem;
        }
      }
    }
  }
}
</style>