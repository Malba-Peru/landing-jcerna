---
import { clients } from "../../data-list";
---

<section class="clients">
  <div class="container">

    <h2 class="section-title">
      CLIENTES
    </h2>

    <div class="grid">
      {
        clients.map((client) => (
          <div class="client-card">
            <img src={client.logo} alt={client.name} loading="lazy" />
          </div>
        ))
      }
    </div>

  </div>
</section>

<style lang="scss">
.clients {
  padding: 5rem 7%;
  background: #f8fafc;

  .container {
    max-width: 1400px;
    margin: auto;
  }

  .section-title {
    text-align: center;

    color: #0174B7;

    font-size: 2em;

    font-weight: 600;

    margin-bottom: 1rem;


  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
  }

  .client-card {
    height: 120px;

    background: white;

    border: 1px solid #e5e7eb;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 1.5rem;

    cursor: pointer;

    transition: all 0.35s ease;

    img {
      max-width: 180px;
      max-height: 65px;

      object-fit: contain;

      filter: grayscale(100%);
      opacity: 0.75;

      transition: all 0.35s ease;
    }

    &:hover {
      background: #0050a7;

      border-color: #386bf8;

      transform: translateY(-4px);

      box-shadow: 0 15px 30px rgba(14, 165, 233, 0.18);

      img {
        filter: grayscale(0%);
        opacity: 1;

        transform: scale(1.04);
      }
    }
  }

  @media (max-width: 992px) {
    padding: 4rem 5%;

    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .client-card {
      height: 110px;
    }
  }

  @media (max-width: 576px) {
    padding: 3.5rem 4%;

    .section-title {
      margin-bottom: 1.5rem;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .client-card {
      height: 95px;
      padding: 1rem;

      img {
        max-width: 145px;
        max-height: 50px;
      }
    }
  }
}
</style>