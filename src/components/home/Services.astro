---
import Icon from "astro-icon";
import { services } from "../../data-list";
import Divider from "../ui/Divider.astro";
---

<section id="services">
    <h2>Nuestros Servicios</h2>

    <div class="services-container">

        <article>
            <div class="services-icon">
                <Icon
                    class="icon"
                    pack="mdi"
                    name="construction"
                    size={60}
                    color="white"
                />
            </div>

            <div class="services-divider">
                <Divider />
            </div>

            <div>
                <h3>Construcción</h3>

                <p>{services.construction.paragraph}</p>

                <ul>
                    {
                        services.construction.list.map((item) => (
                            <li>
                                <Icon
                                    class="icon"
                                    pack="mdi"
                                    name="check"
                                    size={19}
                                />
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </article>

        <article>
            <div class="services-icon">
                <Icon
                    class="icon"
                    pack="ic"
                    name="sharp-construction"
                    size={60}
                    color="white"
                />
            </div>

            <div class="services-divider">
                <Divider />
            </div>

            <div>
                <h3>Acabados</h3>

                <p>{services.finishes.paragraph}</p>

                <ul>
                    {
                        services.finishes.list.map((item) => (
                            <li>
                                <Icon
                                    class="icon"
                                    pack="mdi"
                                    name="check"
                                    size={19}
                                />
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </article>

        <article>
            <div class="services-icon">
                <Icon
                    class="icon"
                    pack="healthicons"
                    name="medical-advice"
                    size={60}
                    color="white"
                />
            </div>

            <div class="services-divider">
                <Divider />
            </div>

            <div>
                <h3>Asesorías</h3>

                <p>{services.advice.paragraph}</p>

                <ul>
                    {
                        services.advice.list.map((item) => (
                            <li>
                                <Icon
                                    class="icon"
                                    pack="mdi"
                                    name="check"
                                    size={19}
                                />
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </article>

    </div>
</section>

<style lang="scss">
section {
    background: #0d77c1;
    max-width: 100%;
    margin: 2rem auto;
    padding: 1.5rem;

    h2 {
        color: white;
        font-size: 2.5rem;
        text-align: center;
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 2rem;
    }

    .services-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6rem;
        margin: 0 1.5rem;

        article {
            background: white;
            border-radius: 1rem;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 1rem;
            transition: all .3s ease;

            &:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            }

            .services-icon {
                background: #0d77c1;
                padding: .8rem;
                border-radius: 50%;
            }

            .services-divider {
                width: 100%;
            }

            div:last-child {
                padding: 1rem;
                display: flex;
                flex-direction: column;
                gap: .5rem;
                text-align: justify;

                h3 {
                    text-align: center;
                    color: #0d77c1;
                    font-size: 1.5rem;
                    margin-bottom: .5rem;
                }

                p {
                    line-height: 1.6;
                }

                ul {
                    list-style: none;
                    display: flex;
                    flex-direction: column;
                    gap: .5rem;

                    li {
                        display: flex;
                        gap: .5rem;
                        align-items: flex-start;
                    }
                }
            }
        }
    }

    /* TABLET GRANDE */
    @media (max-width: 992px) {
        .services-container {
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem;
            margin: 0 1rem;
        }
    }

    /* TABLET */
    @media (max-width: 768px) {
        padding: 1.2rem;

        h2 {
            font-size: 2rem;
        }

        .services-container {
            grid-template-columns: 1fr;
            gap: 2rem;
            margin: 0 .5rem;
        }
    }

    /* MÓVIL */
    @media (max-width: 480px) {
        padding: 1rem;

        h2 {
            font-size: 1.8rem;
        }

        .services-container {
            gap: 1.5rem;
            margin: 0;
        }

        article {
            padding: .8rem;
        }
    }
}
</style>